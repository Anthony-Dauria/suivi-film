# ---------------------------------------------------------------------------
# Cle API TMDB (obligatoire)
# ---------------------------------------------------------------------------
# 1. Creez un compte gratuit sur https://www.themoviedb.org/signup
# 2. Rendez-vous sur https://www.themoviedb.org/settings/api
# 3. Copiez soit la "Cle API (v3 auth)", soit le "Jeton d'acces en lecture (v4)"
#    Les deux formats sont acceptes automatiquement par l'application.
TMDB_API_KEY=

# Pays utilise pour les plateformes de streaming et les dates de sortie (ISO 3166-1)
TMDB_REGION=FR

# Langue des fiches (ISO 639-1 - ISO 3166-1)
TMDB_LANGUAGE=fr-FR

# Emplacement du fichier de donnees de la bibliotheque personnelle
# DATA_FILE=./data/bibliotheque.json
